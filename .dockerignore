# 版本控制
.git/
.gitignore

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# IDE / 工具索引
.idea/
.vscode/
.codegraph/
.claude/
.superpowers/

# 密钥（绝不进镜像层，由 Docker Compose / 部署平台注入）
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.yml
secrets*.yaml
id_rsa*
id_ed25519*
*.jks
*.keystore

# 参考 / 学习资料（运行时不需要，体积大）
参考项目/
learning/
LLM-wiki
mcp-learning/

# 文档（运行时不需要）
CLAUDE.md
AGENTS.md
工程审查报告.md
*.md

# 评测 / 测试（运行时不需要）
eval/
eval_rag25/
tests/

# 归档的旧 Streamlit 前端
legacy/

# 运行时数据与知识库原文（挂载为 volume，不进镜像）
/logs/
*.log
/runtime/
/data/
/chroma_db/
/manifest.json
/parent_docstore.json
*.sqlite
*.sqlite3
*.db

# 项目根 data/ 不进镜像，但 Ultralytics 的 Python 数据模块必须保留。
!ultralytics/data/
!ultralytics/data/**

# 训练过程产物（运行时只需要 best.pt）
**/events.out.tfevents*
**/weights/last.pt
**/train_batch*.jpg
Detct_prdc/runs/
Detct_prdc/MBE-Net/args.yaml

# Windows 脚本（Linux 容器用不上）
*.bat

# OS 临时文件
Thumbs.db
.DS_Store

# Docker 自身文件（避免进 build context）
Dockerfile
docker-compose.yml
.dockerignore
