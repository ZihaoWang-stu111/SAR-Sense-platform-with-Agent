# 复制本文件为 .env 并填入真实 key
# .env 已被 .gitignore 忽略，不会进版本库

# Tavily 联网搜索 API key（https://tavily.com）
TAVILY_API_KEY=""

# 阿里云 DashScope API key（https://dashscope.console.aliyun.com）
# ChatTongyi / DashScopeEmbeddings 通过此环境变量鉴权
DASHSCOPE_API_KEY=""

# 可选：覆盖默认 JWT secret（默认值在 utils/security.py）
# JWT_SECRET=""

# --- Docker 部署说明 ---
# docker compose 会自动读取本文件的 DASHSCOPE_API_KEY / TAVILY_API_KEY 注入 app 容器。
# MySQL 连接参数（MYSQL_HOST 等）已写在 docker-compose.yml，无需在此设置。
#
# 本地直接 python api_server_fastapi.py 运行时：
#   上述 MYSQL_* 环境变量未设置，db_conf.py / crud/metrics.py 用默认值
#   localhost:3306/root/root，本地开发照常工作（环境变量改造向后兼容）。

# --- MinerU PDF 解析服务（可选，docker 部署由 compose 注入，无需在此设置）---
# MINERU_API_URL=http://mineru:8000   # app 调用 mineru 容器的地址
# MINERU_ENABLED=true                  # false 则全程走 PyPDFLoader
# MINERU_TIMEOUT=600                   # 秒，CPU pipeline 解析 2.8MB 论文约 150s，默认 600 够大多数 PDF
