# 复制本文件为 .env，并填写空值项。
# .env 与 .env.* 已被 .gitignore 忽略；不要提交真实凭据。

# --- 应用安全 ---
# 密钥和初始管理员密码都必须显式设置。
APP_ENV=development
# 可用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成。
JWT_SECRET=""
ADMIN_USERNAME=admin
ADMIN_PASSWORD=""
# 多个来源用逗号分隔；生产环境改为真实前端域名。
CORS_ORIGINS="http://localhost:5000,http://127.0.0.1:5000"

# --- 外部模型与搜索服务 ---
# Tavily 联网搜索可选；不配置时 web_search 工具不可用。
TAVILY_API_KEY=""

# 当前 embedding 使用 DashScope，因此即使聊天走 Ollama 也需要此项。
DASHSCOPE_API_KEY=""

# 本地默认值来自 config/rag.yml；需要覆盖时取消注释。
# CHAT_PROVIDER=ollama
# CHAT_MODEL_NAME=qwen3.5:4b
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL_NAME=qwen3.7-text-embedding
# RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# --- MySQL ---
# Docker Compose 和本地直跑都要求密码非空。
MYSQL_ROOT_PASSWORD=""
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sar_sense
MYSQL_USER=sar_sense
MYSQL_PASSWORD=""

# --- Redis / MinerU（可选）---
# REDIS_URL=redis://localhost:6379/0
# TRAFFIC_CONTROL_ENABLED=true
# MINERU_API_URL=http://mineru:8000   # app 调用 mineru 容器的地址
# MINERU_ENABLED=true                  # false 则全程走 PyPDFLoader
# MINERU_TIMEOUT=600                   # 秒，CPU pipeline 解析 2.8MB 论文约 150s，默认 600 够大多数 PDF
